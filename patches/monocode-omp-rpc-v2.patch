+/** Parse an OMP RPC v2 chunk at the stdout boundary. */
+export function parseRpcChunk(rec: Record<string, unknown>): PiRpcChunk | null {
+  if (stringField(rec, "type") !== "rpc_chunk") return null;
+  const chunkId = stringField(rec, "chunkId");
+  const index = rec.index;
+  const count = rec.count;
+  const byteLength = rec.byteLength;
+  const data = rec.data;
+  if (
+    !chunkId ||
+    typeof index !== "number" ||
+    !Number.isInteger(index) ||
+    index < 0 ||
+    typeof count !== "number" ||
+    !Number.isInteger(count) ||
+    count <= 0 ||
+    count > 100_000 ||
+    index >= count ||
+    typeof byteLength !== "number" ||
+    !Number.isInteger(byteLength) ||
+    byteLength < 0 ||
+    typeof data !== "string"
+  ) {
+    return null;
+  }
+  return { chunkId, index, count, byteLength, data };
+}
+
+/** Decode one base64-encoded RPC v2 chunk without assuming UTF-8 boundaries. */
+export function decodeRpcChunkData(data: string): Uint8Array | null {
+  try {
+    const binary = atob(data);
+    const bytes = new Uint8Array(binary.length);
+    for (let index = 0; index < binary.length; index += 1) {
+      bytes[index] = binary.charCodeAt(index);
+    }
+    return bytes;
+  } catch {
+    return null;
+  }
+}
